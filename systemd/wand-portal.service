# Reference unit for spec R3.2. Install to /etc/systemd/system/ then:
#   sudo systemctl enable --now wand-portal
[Unit]
Description=Wand Portal - IR wand gesture recognition
Documentation=file:///opt/wand-portal/SPEC.md
# Start even if the network never comes up: MQTT retries in the background and
# recognition works meanwhile. Wants= not Requires= is deliberate.
Wants=network-online.target
After=network-online.target

[Service]
# notify, not simple: main.py sends sd_notify READY=1 once the engine is up, so
# systemd knows the difference between "process started" and "watching for spells".
Type=notify
User=wand
SupplementaryGroups=video gpio audio
WorkingDirectory=/opt/wand-portal
Environment=WAND_CONFIG=/opt/wand-portal/config.yaml
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wand-portal/.venv/bin/python -m wandportal

Restart=always
RestartSec=5
# main.py now pings WATCHDOG=1 at half this interval, so a genuinely hung
# process is restarted while a healthy one is left alone.
WatchdogSec=60

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/wand-portal/data

[Install]
WantedBy=multi-user.target
